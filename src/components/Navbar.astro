---
const links = [
  { label: "Carta", href: "#especialidades" },
  { label: "El milagro", href: "#anatomia" },
  { label: "Santoral", href: "#santoral" },
  { label: "TikTok", href: "#tiktok" },
  { label: "Feedback", href: "#feedback" },
  { label: "Ubicación", href: "#ubicacion" },
];
const bulbs = Array.from({ length: 11 }, (_, index) => {
  const position = index / 10;
  return {
    position: position * 100,
    drop: 24 * position * (1 - position),
    delay: -(index * .37),
    color: index % 2 === 0 ? "red" : "green",
  };
});
---

<header class="fixed inset-x-0 top-0 z-40 pt-3 sm:pt-4">
  <div class="container relative">
    <nav
      id="siteNav"
      class="relative z-50 flex min-h-16 items-center justify-between gap-2 rounded-full border border-line bg-[var(--sg-nav)] px-3 shadow-[0_14px_40px_rgb(20_8_2/.12)] backdrop-blur-xl transition-all duration-300 sm:px-4 md:gap-3"
      aria-label="Navegación principal"
    >
      <a
        href="#inicio"
        class="flex shrink-0 items-center gap-2"
        aria-label="Sanguchon, volver al inicio"
      >
        <img
          src="/images/brand/logo-san-guchon.webp"
          width="512"
          height="461"
          alt=""
          class="logo-premium h-9 w-9 object-contain sm:h-12 sm:w-12 md:h-11 md:w-11"
        />
        <span
          class="whitespace-nowrap font-display text-base leading-none tracking-wide text-ink sm:text-xl"
          >SAN GUCHON<span class="text-fire">.</span></span
        >
      </a>

      <!-- Desktop Menu -->
      <div
        class="hidden items-center gap-6 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-muted lg:flex"
      >
        {
          links.map((link) => (
            <a class="transition-colors hover:text-fire" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <span class="mobile-season-badge md:hidden">Edición Navidad</span>
        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobileMenuBtn"
          type="button"
          class="grid size-11 shrink-0 place-items-center rounded-full border border-line bg-surface-raised text-ink shadow-sm transition-colors hover:text-fire md:size-10 lg:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobileMenu"
        >
          <svg
            class="menu-icon-open size-[20px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M4 6h16M4 12h16M4 18h16"></path></svg
          >
          <svg
            class="menu-icon-close hidden size-[20px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"></path></svg
          >
        </button>
      </div>
      <div class="nav-garland" aria-hidden="true">
        {bulbs.map(({ position, drop, delay, color }) => (
          <span
            class="nav-garland__pendant"
            data-color={color}
            style={`--position:${position}%;--drop:${drop}px;--delay:${delay}s`}
          ><i></i></span>
        ))}
      </div>
    </nav>

    <!-- Mobile Menu Dropdown -->
    <div
      id="mobileMenu"
      inert
      class="pointer-events-none absolute left-0 right-0 top-full z-40 mt-2 -translate-y-4 opacity-0 transition-all duration-300 lg:hidden"
    >
      <div
        class="flex flex-col gap-6 rounded-[1.5rem] border border-line bg-[var(--sg-nav)] p-6 shadow-2xl backdrop-blur-2xl"
      >
        {
          links.map((link) => (
            <a
              class="mobile-menu-link text-xs font-bold uppercase tracking-[0.16em] text-ink transition-colors hover:text-fire"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Logic
  const mobileMenuBtn = document.getElementById("mobileMenuBtn");
  const mobileMenu = document.getElementById("mobileMenu");
  const mobileMenuLinks = document.querySelectorAll(".mobile-menu-link");
  const iconOpen = mobileMenuBtn?.querySelector(".menu-icon-open");
  const iconClose = mobileMenuBtn?.querySelector(".menu-icon-close");

  function toggleMenu(forceClose = false) {
    if (!mobileMenuBtn || !mobileMenu) return;
    const isExpanded = mobileMenuBtn.getAttribute("aria-expanded") === "true";

    if (isExpanded || forceClose) {
      mobileMenuBtn.setAttribute("aria-expanded", "false");
      mobileMenuBtn.setAttribute("aria-label", "Abrir menú");
      mobileMenu.inert = true;
      mobileMenu.classList.remove(
        "opacity-100",
        "translate-y-0",
        "pointer-events-auto",
      );
      mobileMenu.classList.add(
        "opacity-0",
        "-translate-y-4",
        "pointer-events-none",
      );
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    } else {
      mobileMenuBtn.setAttribute("aria-expanded", "true");
      mobileMenuBtn.setAttribute("aria-label", "Cerrar menú");
      mobileMenu.inert = false;
      mobileMenu.classList.remove(
        "opacity-0",
        "-translate-y-4",
        "pointer-events-none",
      );
      mobileMenu.classList.add(
        "opacity-100",
        "translate-y-0",
        "pointer-events-auto",
      );
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    }
  }

  mobileMenuBtn?.addEventListener("click", () => toggleMenu());

  document.addEventListener("keydown", (event) => {
    if (
      event.key !== "Escape" ||
      mobileMenuBtn?.getAttribute("aria-expanded") !== "true" ||
      !mobileMenuBtn.getClientRects().length
    ) return;

    event.preventDefault();
    toggleMenu(true);
    mobileMenuBtn.focus();
  });

  mobileMenuLinks.forEach((link) => {
    link.addEventListener("click", () => toggleMenu(true));
  });

  const siteNav = document.getElementById("siteNav");
  const syncScrolledNav = () =>
    siteNav?.classList.toggle("nav-is-scrolled", window.scrollY > 28);
  syncScrolledNav();
  window.addEventListener("scroll", syncScrolledNav, { passive: true });
</script>

<style>
  .nav-garland {
    position: absolute;
    inset: 100% clamp(1.4rem, 8%, 5rem) auto;
    height: 1.2rem;
    pointer-events: none;
  }

  .nav-garland::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 7px;
    border-bottom: 1px solid #a797775e;
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
  }

  .nav-garland__pendant {
    --bulb: #ff4e68;
    --highlight: #ffd1d5;
    position: absolute;
    top: var(--drop);
    left: var(--position);
    width: 8px;
    margin-left: -4px;
    transform-origin: 50% 0;
  }

  .nav-garland__pendant[data-color="green"] {
    --bulb: #2fda87;
    --highlight: #d1ffdb;
  }

  .nav-garland__pendant::before {
    content: "";
    display: block;
    width: 4px;
    height: 4px;
    margin-inline: auto;
    border-radius: 1px;
    background: linear-gradient(90deg, #4c3c35, #a68c6e, #5d483b);
  }

  .nav-garland__pendant i {
    display: block;
    width: 8px;
    height: 10px;
    border-radius: 42% 42% 58% 58%;
    background: radial-gradient(circle at 35% 28%, var(--highlight), var(--bulb) 65%);
    box-shadow: 0 0 8px var(--bulb);
  }

  #siteNav:has(#mobileMenuBtn[aria-expanded="true"]) .nav-garland {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-garland__pendant { animation: bulb-sway 3.6s var(--delay) ease-in-out infinite alternate; }
    .nav-garland__pendant i { animation: bulb-blink 2.8s var(--delay) ease-in-out infinite; }
  }

  @keyframes bulb-sway {
    from { transform: rotate(-6deg); }
    to { transform: rotate(6deg); }
  }

  @keyframes bulb-blink {
    0%, 66%, 100% { opacity: .24; }
    14%, 44% { opacity: 1; }
  }

  .mobile-season-badge {
    border: 1px solid #dca76955;
    border-radius: 999px;
    padding: .32rem .45rem;
    color: #ffe0a2;
    font-size: .59rem;
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  #siteNav.nav-is-scrolled {
    box-shadow: 0 16px 44px rgb(20 8 2 / 0.2);
    transform: scale(0.985);
  }
</style>
