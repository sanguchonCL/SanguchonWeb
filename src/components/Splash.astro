<script>
  const splash = document.getElementById("siteSplash");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (splash && reduceMotion) {
    splash.hidden = true;
  } else if (splash) {
    window.setTimeout(() => splash.classList.add("is-leaving"), 900);
    window.setTimeout(() => {
      splash.hidden = true;
