<script>
  const splash = document.getElementById("siteSplash");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (splash && !reduceMotion && !window.location.hash) {
    const avalancheDelay = window.matchMedia("(width < 768px)").matches ? 1640 : 1480;
    const fadeDelay = avalancheDelay + 300;
    window.setTimeout(() => splash.classList.add("is-avalanche"), avalancheDelay);
    window.setTimeout(() => splash.classList.add("is-leaving"), fadeDelay);
    window.setTimeout(() => {
      splash.hidden = true;
    }, fadeDelay + 500);
    splash.hidden = false;
  }
</script>
