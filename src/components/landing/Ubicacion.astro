---
import { SITE_INFO } from "../../data/site-info";
import ChristmasSnow from "../ChristmasSnow.astro";

---

<section id="ubicacion" class="relative isolate overflow-hidden bg-canvas py-5 text-ink sm:py-8">
  <ChristmasSnow />
  <div
    class="container grid overflow-hidden rounded-[1.5rem] bg-surface-raised shadow-[0_20px_55px_rgb(34_15_7/.1)] ring-1 ring-line lg:grid-cols-[1.15fr_.85fr]"
  >
    <div class="flex flex-col justify-between p-7 sm:p-10 lg:col-start-2 lg:row-start-1">
      <div>
        <p class="text-[0.65rem] font-bold uppercase tracking-[.2em] text-fire">
          Punto de encuentro
        </p>
        <h2 class="mt-5 font-display text-5xl leading-[.85]">
          SAN<br />MIGUEL.
        </h2>
      </div>
      <div class="mt-10 border-t border-line pt-5">
        <p class="text-sm font-medium">San Nicolás 1390, San Miguel</p>
        <p class="mt-2 text-sm text-muted">Santiago, Chile</p>
        <aside class="mt-5 rounded-xl border border-[#ffc878]/30 bg-[#473020]/25 p-4" aria-label="Horarios del local">
          <p class="text-xs font-bold uppercase tracking-[.12em] text-[#ffc878]">Horario habitual</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{SITE_INFO.schedule}</p>
        </aside>
        <a
          href={SITE_INFO.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-fire px-5 py-3 text-xs font-bold uppercase tracking-[.15em] text-white transition hover:-translate-y-0.5 hover:bg-fire-bright"
          >Cómo llegar <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
    <div
      class="relative min-h-64 lg:col-start-1 lg:row-start-1 overflow-hidden bg-charcoal saturate-[.8] contrast-[1.08] lg:min-h-[30rem]"
    >
      <iframe
        class="absolute inset-0 h-full w-full pointer-events-none opacity-90"
        title="Ubicación de San Guchon"
        src={SITE_INFO.googleMapsIframeUrl}
        tabindex="-1"
        aria-hidden="true"
        loading="lazy"
        allow="fullscreen"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div
        class="pointer-events-none absolute inset-0 bg-fire/10 mix-blend-multiply"
      >
      </div>
    </div>
  </div>
</section>
