---
import { SITE_INFO } from "../../data/site-info";
import logoSanGuchon from "../../assets/logo-san-guchon.svg";

const realTikTokVideos = [
  {
    id: "7668534587026345223",
    url: "https://www.tiktok.com/@sanguchoncl/video/7668534587026345223",
    title: "Alguien más de santo? #fyp #sanguchon",
    image: "/images/tiktok/video1.jpg",
    views: "29.2K",
    likes: "3.4K",
    duration: "0:28",
    tag: "#SANTO",
    isNew: false,
  },
  {
    id: "7665481226551102728",
    url: "https://www.tiktok.com/@sanguchoncl/video/7665481226551102728",
    title: "Tan malo es pedirse una hamburguesa triple? #sanguchon #hamburguesa #polemica",
    image: "/images/tiktok/video2.jpg",
    views: "13.0K",
    likes: "1.8K",
    duration: "0:32",
    tag: "#TRIPLE",
    isNew: false,
  },
  {
    id: SITE_INFO.latestTikTokVideoId,
    url: SITE_INFO.latestTikTokVideoUrl,
    title: "Último video desde el local Sanguchon #sanguchon #sangucheria",
    image: "/images/tiktok/cover-1.png",
    views: "Nuevo",
    likes: "",
    duration: "",
    tag: "#NUEVO",
    isNew: true,
  },
];
---

<section
  id="tiktok"
  class="relative overflow-hidden border-b border-line bg-charcoal py-18 text-white sm:py-24"
>
  <!-- Ambient Gradient Accents -->
  <div
    class="pointer-events-none absolute -left-32 top-1/4 h-96 w-96 rounded-full bg-[radial-gradient(circle,rgba(0,242,254,0.12),transparent_70%)]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -right-32 bottom-1/4 h-96 w-96 rounded-full bg-[radial-gradient(circle,rgba(255,0,80,0.14),transparent_70%)]"
    aria-hidden="true"
  ></div>

  <div class="container relative z-10">
    <!-- Header -->
    <header
      class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
    >
      <div class="max-w-xl">
        <div class="mb-4 flex items-center gap-3">
          <span
            class="flex items-center gap-2 rounded-full border border-[#ff0050]/40 bg-[#ff0050]/10 px-3.5 py-1 text-[0.65rem] font-bold uppercase tracking-[.2em] text-[#ff4b72]"
          >
            <!-- TikTok SVG Icon -->
            <svg
              class="size-3.5 fill-current"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-2.887 2.884 2.893 2.893 0 0 1-2.895-2.884 2.893 2.893 0 0 1 2.895-2.883c.4 0 .782.083 1.13.232v-3.53a6.376 6.376 0 0 0-1.13-.101 6.34 6.34 0 0 0-6.333 6.333 6.338 6.338 0 0 0 6.333 6.333 6.341 6.341 0 0 0 6.333-6.333V9.222a8.163 8.163 0 0 0 4.774 1.521V7.298a4.845 4.845 0 0 1-1.006-.612z"
              ></path>
            </svg>
            06 / EN VIVO EN TIKTOK
          </span>
          <span class="patria-chip inline-flex items-center rounded-full border px-3 py-1 text-[0.6rem] font-bold uppercase tracking-[.16em] text-white/80">Especial de septiembre</span>
          <span class="flex items-center gap-1.5 text-xs text-emerald-400 font-semibold">
            <span class="relative flex size-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
            </span>
            Sincronizado con @sanguchoncl
          </span>
        </div>

        <h2
          class="font-display text-[clamp(2.5rem,5.5vw,4.8rem)] leading-[.88] tracking-[-.03em] text-white"
        >
          TIKTOK DE TU <br />
          <span
            class="bg-gradient-to-r from-[#00f2fe] via-[#ff0050] to-fire bg-clip-text text-transparent"
          >
            SANGUCHERÍA
          </span>
        </h2>
      </div>

      <!-- Real Profile Card -->
      <div class="flex flex-col gap-3 max-w-md w-full">
        <p class="text-xs leading-relaxed text-white/70 sm:text-sm">
          Mira los videos reales del local, promociones y novedades. Haz clic en cualquier video para verlo directamente en TikTok y sumar visitas a la cuenta oficial.
        </p>

        <a
          href={SITE_INFO.tiktokUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-2xl border border-white/12 bg-white/5 p-3.5 backdrop-blur-md transition duration-300 hover:border-[#ff0050]/60 hover:bg-white/10"
        >
          <div class="flex items-center gap-3">
            <div class="relative">
              <img
                src={logoSanGuchon.src}
                alt="Sanguchón logo"
                class="size-11 rounded-full border border-cheese/40 bg-black/50 p-1 object-contain shadow"
              />
              <span
                class="absolute -bottom-0.5 -right-0.5 flex size-4 items-center justify-center rounded-full bg-[#ff0050] text-[9px] font-bold text-white shadow"
                title="Cuenta Oficial Verificada"
              >
                ✓
              </span>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-white text-sm">@sanguchoncl</span>
              </div>
              <div class="flex items-center gap-2.5 text-xs text-white/60 mt-0.5">
                <span><strong>87</strong> Seguidores</span>
                <span>•</span>
                <span><strong>6.16K</strong> Likes</span>
              </div>
            </div>
          </div>

          <span
            class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-[#ff0050] to-fire px-4 py-2 text-xs font-bold text-white shadow transition duration-300 group-hover:scale-105"
          >
            Seguir
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </span>
        </a>
      </div>
    </header>

    <!-- Slider Control Bar -->
    <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
      <span class="text-xs font-bold uppercase tracking-wider text-white/50">
        Videos Recientes & Contenido Destacado
      </span>

      <!-- Slider Controls (Prev / Next Buttons) -->
      <div class="flex items-center gap-2">
        <button
          id="btnSliderPrev"
          type="button"
          class="flex size-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/80 transition-all hover:border-[#ff0050] hover:bg-[#ff0050] hover:text-white disabled:opacity-30 disabled:pointer-events-none"
          aria-label="Video anterior"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>

        <button
          id="btnSliderNext"
          type="button"
          class="flex size-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/80 transition-all hover:border-[#ff0050] hover:bg-[#ff0050] hover:text-white disabled:opacity-30 disabled:pointer-events-none"
          aria-label="Siguiente video"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- TikTok Horizontal Slider / Carousel Container -->
    <div
      id="tiktokCarousel"
      class="no-scrollbar flex w-full gap-5 overflow-x-auto scroll-smooth py-2 snap-x snap-mandatory focus:outline-none"
      tabindex="0"
    >
      {
        realTikTokVideos.map((video) => (
          <a
            href={video.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex aspect-[9/16] w-[270px] shrink-0 snap-start flex-col justify-between overflow-hidden rounded-2xl border border-white/15 bg-surface-raised transition-all duration-400 hover:-translate-y-1.5 hover:border-[#ff0050]/70 hover:shadow-[0_20px_45px_rgba(255,0,80,0.25)] sm:w-[290px] md:w-[300px]"
          >
            <!-- Real Thumbnail Image -->
            <img
              src={video.image}
              alt={video.title}
              width="500"
              height="888"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />

            <!-- Gradient Layer -->
            <div
              class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/30 to-black/40 transition-opacity duration-300 group-hover:opacity-90"
              aria-hidden="true"
            ></div>

            <!-- Top Badges -->
            <div class="relative z-10 flex items-center justify-between p-4">
              <span class="rounded-full border border-white/20 bg-black/60 px-3 py-1 text-[0.6rem] font-bold uppercase tracking-wider text-white backdrop-blur-md">
                {video.tag}
              </span>
              {video.isNew && (
                <span class="rounded-full bg-[#ff0050] px-2.5 py-0.5 text-[0.58rem] font-black uppercase tracking-wider text-white shadow">
                  NUEVO
                </span>
              )}
            </div>

            <!-- Play Icon Center -->
            <div class="relative z-10 flex justify-center transition-transform duration-300 group-hover:scale-125">
              <div class="flex size-14 items-center justify-center rounded-full border border-white/40 bg-black/50 text-white backdrop-blur-md shadow-xl group-hover:border-cheese group-hover:bg-[#ff0050]">
                <svg class="size-6 translate-x-0.5 fill-current text-white" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>

            <!-- Video Data Bottom -->
            <div class="relative z-10 p-5">
              <p class="line-clamp-2 text-sm font-bold leading-snug text-white group-hover:text-cheese transition-colors">
                {video.title}
              </p>

              <div class="mt-3 flex items-center justify-between border-t border-white/15 pt-3 text-xs text-white/80">
                <span class="flex items-center gap-1.5 font-bold text-white">
                  <svg class="size-4 text-[#00f2fe]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                  {video.views} vistas
                </span>

                <span class="flex items-center gap-1 font-medium text-white/70">
                  Ver en TikTok
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 17L17 7M17 7H7M17 7V17"></path>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }

      <!-- Card 3: Ver Perfil Completo en TikTok -->
      <a
        href={SITE_INFO.tiktokUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex aspect-[9/16] w-[270px] shrink-0 snap-start flex-col justify-between overflow-hidden rounded-2xl border border-dashed border-white/25 bg-white/5 p-6 transition-all duration-300 hover:border-[#ff0050] hover:bg-white/10 sm:w-[290px] md:w-[300px]"
      >
        <div class="flex items-center justify-between">
          <span class="rounded-full bg-white/10 px-3 py-1 text-[0.6rem] font-bold uppercase tracking-wider text-white">
            MÁS CONTENIDO
          </span>
        </div>

        <div class="my-auto text-center">
          <div class="mx-auto mb-4 flex size-15 items-center justify-center rounded-full bg-gradient-to-tr from-[#ff0050] to-[#00f2fe] text-white shadow-xl transition duration-500 group-hover:scale-110">
            <svg class="size-7 fill-current" viewBox="0 0 24 24">
              <path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-2.887 2.884 2.893 2.893 0 0 1-2.895-2.884 2.893 2.893 0 0 1 2.895-2.883c.4 0 .782.083 1.13.232v-3.53a6.376 6.376 0 0 0-1.13-.101 6.34 6.34 0 0 0-6.333 6.333 6.338 6.338 0 0 0 6.333 6.333 6.341 6.341 0 0 0 6.333-6.333V9.222a8.163 8.163 0 0 0 4.774 1.521V7.298a4.845 4.845 0 0 1-1.006-.612z"/>
            </svg>
          </div>
          <h3 class="font-display text-2xl text-white">VER PERFIL COMPLETO</h3>
          <p class="mt-2 text-xs leading-relaxed text-white/60">
            Revisa todos los videos subidos a <strong>@sanguchoncl</strong> directamente en la app o sitio de TikTok.
          </p>
        </div>

        <div class="flex items-center justify-center gap-2 rounded-full border border-white/20 bg-black/40 py-2.5 text-xs font-bold text-white transition group-hover:border-[#ff0050] group-hover:text-[#ff4b72]">
          Abrir en TikTok
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17L17 7M17 7H7M17 7V17"></path>
          </svg>
        </div>
      </a>

      <!-- Card 4: Sincronización Automática Info -->
      <div
        class="relative flex aspect-[9/16] w-[270px] shrink-0 snap-start flex-col justify-between rounded-2xl border border-white/12 bg-gradient-to-b from-white/5 to-charcoal p-6 sm:w-[290px] md:w-[300px]"
      >
        <div class="flex items-center justify-between">
          <span class="rounded-full bg-emerald-500/20 px-3 py-1 text-[0.6rem] font-bold uppercase tracking-wider text-emerald-400 border border-emerald-500/30">
            AUTO-SYNC
          </span>
        </div>

        <div class="my-auto">
          <div class="mb-3 flex items-center gap-2 text-cheese">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
            <span class="font-bold text-xs uppercase tracking-wider">Feed En Vivo</span>
          </div>
          <h4 class="font-display text-xl leading-snug text-white">
            NUEVOS VIDEOS APARECEN AUTOMÁTICAMENTE
          </h4>
          <p class="mt-2 text-xs leading-relaxed text-white/60">
            Cuando el equipo de Sanguchón suba un nuevo TikTok, la portada y las estadísticas se muestran de inmediato.
          </p>
        </div>

        <a
          href={SITE_INFO.tiktokUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 rounded-full bg-[#ff0050] py-2.5 text-xs font-bold text-white shadow-lg transition hover:bg-[#ff1f66]"
        >
          Síguenos en @sanguchoncl
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17L17 7M17 7H7M17 7V17"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom Banner CTA -->
    <div
      class="mt-10 flex flex-col items-center justify-between gap-5 rounded-3xl border border-white/10 bg-gradient-to-r from-surface-raised via-charcoal to-surface-raised p-6 text-center sm:flex-row sm:p-8 sm:text-left shadow-xl"
    >
      <div>
        <h3 class="font-display text-2xl tracking-wide text-white sm:text-3xl">
          ¿CON HAMBRE Y BUSCANDO INSPIRACIÓN?
        </h3>
        <p class="mt-1 text-xs text-white/65 sm:text-sm">
          Sigue a <strong>@sanguchoncl</strong> en TikTok para promociones exclusivas y el detrás de escena.
        </p>
      </div>

      <a
        href={SITE_INFO.tiktokUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2.5 rounded-full bg-white px-6 py-3.5 text-xs font-bold uppercase tracking-[.14em] text-charcoal transition-all duration-300 hover:bg-cheese hover:scale-105 shadow-xl"
      >
        <svg
          class="size-4 fill-current text-charcoal"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-2.887 2.884 2.893 2.893 0 0 1-2.895-2.884 2.893 2.893 0 0 1 2.895-2.883c.4 0 .782.083 1.13.232v-3.53a6.376 6.376 0 0 0-1.13-.101 6.34 6.34 0 0 0-6.333 6.333 6.338 6.338 0 0 0 6.333 6.333 6.341 6.341 0 0 0 6.333-6.333V9.222a8.163 8.163 0 0 0 4.774 1.521V7.298a4.845 4.845 0 0 1-1.006-.612z"
          ></path>
        </svg>
        Ir a TikTok @sanguchoncl
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7M17 7H7M17 7V17"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- Custom Scrollbar & Carousel JS Script -->
<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<script>
  const carousel = document.getElementById("tiktokCarousel");
  const btnPrev = document.getElementById("btnSliderPrev");
  const btnNext = document.getElementById("btnSliderNext");

  function updateControls() {
    if (!carousel) return;
    const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth;
    if (btnPrev) {
      (btnPrev as HTMLButtonElement).disabled = carousel.scrollLeft <= 10;
    }
    if (btnNext) {
      (btnNext as HTMLButtonElement).disabled = carousel.scrollLeft >= maxScrollLeft - 10;
    }
  }

  btnPrev?.addEventListener("click", () => {
    if (!carousel) return;
    carousel.scrollBy({ left: -320, behavior: "smooth" });
  });

  btnNext?.addEventListener("click", () => {
    if (!carousel) return;
    carousel.scrollBy({ left: 320, behavior: "smooth" });
  });

  carousel?.addEventListener("scroll", updateControls, { passive: true });
  window.addEventListener("resize", updateControls, { passive: true });
  updateControls();
</script>
