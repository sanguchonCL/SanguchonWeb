<section
  id="historia"
  class="relative border-y border-line py-24 sm:py-32 overflow-hidden"
>
  <img
    src="/images/seasonal/18-septiembre/cueca-silueta.webp"
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="seasonal-only seasonal-cueca seasonal-float pointer-events-none absolute -bottom-12 -left-16 z-[1] w-72 opacity-[.08] sm:w-96 sm:opacity-[.11]"
  />
  <div class="absolute inset-0 z-0">
    <img
      src="/images/venue/terraza.webp"
      srcset="/images/venue/terraza-640.webp 640w, /images/venue/terraza.webp 1200w"
      sizes="100vw"
      alt="Terraza de San Guchon"
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-surface/90 backdrop-blur-sm"></div>
  </div>

  <div
    class="container relative z-10 grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-20"
  >
    <div>
      <p class="text-[0.65rem] font-bold uppercase tracking-[.2em] text-fire">El culto</p>
      <p class="seasonal-only mt-3 inline-flex rounded-full border border-fire/25 bg-fire/10 px-3 py-1 text-[.56rem] font-bold uppercase tracking-[.16em] text-fire">Edición dieciochera</p>
    </div>
    <div>
      <h2
        class="font-display text-[clamp(3.2rem,6vw,6.5rem)] leading-[.84] tracking-[-.03em] text-ink drop-shadow-sm"
      >
        NO HACEMOS<br /><span class="text-muted">COMIDA RÁPIDA.</span>
      </h2>
      <div class="mt-10 grid gap-8 border-t border-line/60 pt-6 sm:grid-cols-2">
        <p class="text-base leading-relaxed text-ink-soft">
          Hacemos hamburguesas sin atajos. Carne con costra, pan que aguanta y
          una parrilla encendida para el barrio.
        </p>
        <p class="text-base leading-relaxed text-ink-soft">
          Sanguchon nació en San Miguel con una regla simple: si no lo
          pediríamos nosotros, no sale de la cocina.
        </p>
      </div>
    </div>
  </div>
  <figure class="container relative z-10 mt-10 sm:mt-14">
    <div class="relative mx-auto aspect-[4/3] max-w-4xl overflow-hidden rounded-2xl bg-charcoal sm:aspect-video">
      <img
        src="/videos/sanguchon-parrilla.webp"
        alt="Hamburguesa preparándose en la parrilla de Sanguchon"
        width="960"
        height="540"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
      <video
        id="historia-video"
        data-src="/videos/sanguchon-parrilla.mp4"
        class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-0"
        aria-hidden="true"
        muted
        loop
        playsinline
        preload="none"
      ></video>
      <button
        id="historia-video-toggle"
        type="button"
        class="absolute bottom-3 right-3 min-h-11 rounded-full bg-black/80 px-4 text-sm font-bold text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:bottom-5 sm:right-5"
        hidden
      >Reproducir video</button>
    </div>
  </figure>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>("#historia-video");
  const button = document.querySelector<HTMLButtonElement>("#historia-video-toggle");

  if (video && button && video.dataset.src) {
    const source = video.dataset.src;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let playbackRequested: boolean | undefined;
    let inView = false;

    function updatePlayback() {
      if (!video) return;
      const shouldPlay = playbackRequested ?? !reducedMotion.matches;

      if (!inView || document.hidden || !shouldPlay) {
        video.pause();
        return;
      }

      if (!video.hasAttribute("src")) video.src = source;
      void video.play().catch(() => {});
    }

    video.addEventListener("playing", () => {
      video.classList.remove("opacity-0");
      button.textContent = "Pausar video";
    });
    video.addEventListener("pause", () => {
      button.textContent = "Reproducir video";
    });
    button.addEventListener("click", () => {
      playbackRequested = video.paused;
      inView = true;
      updatePlayback();
    });

    button.hidden = false;
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        inView = entry.intersectionRatio >= 0.25;
        updatePlayback();
      }, { threshold: 0.25 }).observe(video);
    }
    reducedMotion.addEventListener("change", updatePlayback);
    document.addEventListener("visibilitychange", updatePlayback);
  }
</script>
