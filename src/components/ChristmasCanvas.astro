<canvas class="christmas-canvas" aria-hidden="true"></canvas>

<style>
  .christmas-canvas {
    position: absolute;
    inset: 0;
    z-index: 12;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const motion = matchMedia("(prefers-reduced-motion: reduce)");
  const desktop = matchMedia("(min-width: 768px) and (pointer: fine)");

  const canvases = "IntersectionObserver" in window && "ResizeObserver" in window
    ? document.querySelectorAll<HTMLCanvasElement>(".christmas-canvas")
    : [];
  for (const canvas of canvases) {
    const context = canvas.getContext("2d");
    const stage = canvas.parentElement;
    if (!context || !stage) continue;

    const layers = [
      { count: 18, size: .8, speed: 13, depth: .2, opacity: .42 },
      { count: 12, size: 1.6, speed: 24, depth: .55, opacity: .64 },
      { count: 6, size: 2.6, speed: 36, depth: 1, opacity: .33 },
    ];
    const particles = layers.flatMap((layer) =>
      Array.from({ length: layer.count }, (_, index) => ({
        ...layer,
        index,
        x: Math.random(),
        y: Math.random(),
        phase: Math.random() * Math.PI * 2,
      })),
    );

    const glow = document.createElement("canvas");
    glow.width = glow.height = 24;
    const sprite = glow.getContext("2d");
    if (sprite) {
      const gradient = sprite.createRadialGradient(12, 12, 0, 12, 12, 12);
      gradient.addColorStop(0, "#fff4d6");
      gradient.addColorStop(1, "#fff4d600");
      sprite.fillStyle = gradient;
      sprite.fillRect(0, 0, 24, 24);
    }

    let width = 0;
    let height = 0;
    let visible = false;
    let frame = 0;
    let lastTime = 0;
    let elapsed = 0;
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;

    function draw(time: number) {
      if (!context) return;
      const delta = lastTime ? Math.min((time - lastTime) / 1000, .05) : 0;
      lastTime = time;
      elapsed += delta;
      x += (targetX - x) * Math.min(delta * 6, 1);
      y += (targetY - y) * Math.min(delta * 6, 1);
      context.clearRect(0, 0, width, height);

      for (const particle of particles) {
        if (!desktop.matches && particle.index % 2) continue;
        const px = particle.x * width + Math.sin(elapsed * .65 + particle.phase) * 14 + x * 18 * particle.depth;
        const py = (particle.y * height + elapsed * particle.speed) % (height + 24) - 12 + y * 10 * particle.depth;
        context.globalAlpha = particle.opacity;
        if (particle.depth === 1) {
          context.drawImage(glow, px - 8, py - 8, 16, 16);
        } else {
          context.fillStyle = "#fff4d6";
          context.beginPath();
          context.arc(px, py, particle.size, 0, Math.PI * 2);
          context.fill();
        }
      }
      context.globalAlpha = 1;
      frame = requestAnimationFrame(draw);
    }

    function sync() {
      if (visible && !document.hidden && !motion.matches) {
        if (!frame) frame = requestAnimationFrame(draw);
      } else {
        cancelAnimationFrame(frame);
        frame = 0;
        lastTime = 0;
        context?.clearRect(0, 0, width, height);
      }
    }

    new ResizeObserver(() => {
      const bounds = canvas.getBoundingClientRect();
      const ratio = Math.min(devicePixelRatio || 1, 1.5);
      width = bounds.width;
      height = bounds.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    }).observe(canvas);

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(canvas);

    stage.addEventListener("pointermove", (event) => {
      if (!desktop.matches || motion.matches || event.pointerType !== "mouse") return;
      const bounds = stage.getBoundingClientRect();
      targetX = (event.clientX - bounds.left) / bounds.width - .5;
      targetY = (event.clientY - bounds.top) / bounds.height - .5;
    }, { passive: true });
    stage.addEventListener("pointerleave", () => { targetX = targetY = 0; });
    motion.addEventListener("change", sync);
    document.addEventListener("visibilitychange", sync);
  }
</script>
